{
  "name": "ai-translate",
  "version": "0.1.0",
  "description": "Ai Translate desktop shell built with Electron, Vite and React.",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": "24.x",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k -n vite,electron \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http-get://127.0.0.1:5173 && npm run build:main && cross-env NODE_ENV=development electron .",
    "build:main": "tsc -p tsconfig.build.json",
    "build": "npm run build:main && vite build",
    "lint": "cross-env CI=true eslint .",
    "lint:fix": "cross-env CI=true eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test node --import tsx --test --test-reporter spec \"src/**/*.unit.spec.ts\"",
    "validate": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
}
